---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-first-unsafe-step-dpo" data-fig="first-unsafe-step-dpo"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="first-unsafe-step-dpo"]')) mount(el);
</script>
