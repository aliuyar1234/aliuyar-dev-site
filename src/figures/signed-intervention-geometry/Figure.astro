---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-signed-intervention-geometry" data-fig="signed-intervention-geometry"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="signed-intervention-geometry"]')) mount(el);
</script>
