---
import "./figure.css";
import { render } from "./art.mjs";
const { html } = render();
---
<div class="iso fig fig-robust-discover-distill" data-fig="robust-discover-distill"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="robust-discover-distill"]')) mount(el);
</script>
