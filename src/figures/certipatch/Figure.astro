---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-certipatch" data-fig="certipatch"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="certipatch"]')) mount(el);
</script>
