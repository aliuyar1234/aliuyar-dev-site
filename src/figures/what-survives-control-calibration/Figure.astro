---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-what-survives-control-calibration" data-fig="what-survives-control-calibration"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="what-survives-control-calibration"]')) mount(el);
</script>
