---
import "./figure.css";
import { render } from "./art.mjs";
const { html } = render();
---
<div class="iso fig fig-selective-revocation" data-fig="selective-revocation"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="selective-revocation"]')) mount(el);
</script>
