---
import "./figure.css";
import { render } from "./art.mjs";
const { html } = render();
---
<div class="iso fig fig-hero" data-fig="hero"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="hero"]')) mount(el);
</script>
