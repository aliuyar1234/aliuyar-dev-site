---
import "./figure.css";
import { render } from "./art.mjs";
const { html } = render();
---
<div class="iso fig fig-language-neutral-or-language-specific" data-fig="language-neutral-or-language-specific"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="language-neutral-or-language-specific"]')) mount(el);
</script>
