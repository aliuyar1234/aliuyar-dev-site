---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-soar" data-fig="soar"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="soar"]')) mount(el);
</script>
