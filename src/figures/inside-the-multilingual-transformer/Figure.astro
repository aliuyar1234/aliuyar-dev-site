---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-inside-the-multilingual-transformer" data-fig="inside-the-multilingual-transformer"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="inside-the-multilingual-transformer"]')) mount(el);
</script>
