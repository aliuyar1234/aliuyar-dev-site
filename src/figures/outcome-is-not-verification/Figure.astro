---
import { render } from "./art.mjs";
import "./figure.css";
const { html } = render();
---
<div class="iso fig fig-outcome-is-not-verification" data-fig="outcome-is-not-verification"><Fragment set:html={html} /></div>
<script>
  import { mount } from "./live.js";
  for (const el of document.querySelectorAll('[data-fig="outcome-is-not-verification"]')) mount(el);
</script>
