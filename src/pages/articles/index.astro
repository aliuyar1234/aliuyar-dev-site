---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/site";
import { essays, readMinutes } from "../../lib/essays";
---

<BaseLayout title="Writing | Ali Uyar" description="Essays by Ali Uyar on how decisions get made around AI systems: evidence, reversibility, structure and what long use of these systems changes.">
  <header class="wrap page-head">
    <h1 class="h1">Writing</h1>
    <p class="lede">Essays on how decisions get made around AI systems: evidence, reversibility, structure and what long use of these systems changes.</p>
  </header>
  <ol class="wrap list">
    {essays.map((e) => (
      <li>
        <a href={`/articles/${e.slug}/`}>
          <p class="small muted num">{formatDate(e.date)}</p>
          <div>
            <h2 class="h3">{e.title}</h2>
            <p>{e.summary}</p>
          </div>
          <p class="small muted num">{readMinutes(e)} min</p>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .page-head { display: grid; gap: 28px; padding-top: clamp(40px, 7vw, 104px); }
  .list { margin-top: clamp(56px, 7vw, 96px); }
  .list a {
    display: grid; grid-template-columns: 11rem minmax(0, 1fr) 4rem; gap: 10px clamp(20px, 4vw, 56px);
    padding-block: 28px; border-top: 1px solid var(--line); transition: border-color 0.25s var(--ease);
  }
  .list li:last-child a { border-bottom: 1px solid var(--line); }
  .list a:hover { border-top-color: var(--strong); }
  .list a div { display: grid; gap: 10px; max-width: 62ch; }
  .list a > p:last-child { text-align: right; }
  @media (max-width: 760px) {
    .list a { grid-template-columns: minmax(0, 1fr); }
    .list a > p:last-child { display: none; }
  }
</style>
