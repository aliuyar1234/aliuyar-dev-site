---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, formatDate } from "../../lib/site";
import { blocks, essays, readMinutes, words, type Essay } from "../../lib/essays";

export function getStaticPaths() {
  return essays.map((essay) => ({ params: { slug: essay.slug }, props: { essay } }));
}

const { essay } = Astro.props as { essay: Essay };
const index = essays.findIndex((e) => e.slug === essay.slug);
const next = essays[(index + 1) % essays.length];
const url = `${SITE.url}/articles/${essay.slug}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: essay.title,
  description: essay.summary,
  datePublished: essay.date,
  url,
  mainEntityOfPage: url,
  author: { "@type": "Person", "@id": SITE.personId, name: SITE.name },
  publisher: { "@id": SITE.personId },
  image: `${SITE.url}/og/articles/${essay.slug}.png`,
  wordCount: words(essay),
  keywords: essay.tags.join(", "),
};
---

<BaseLayout title={`${essay.title} | Ali Uyar`} description={essay.summary} ogType="article" publishedTime={essay.date} jsonLd={jsonLd} ogImage={`/og/articles/${essay.slug}.png`}>
  <article class="wrap essay">
    <header>
      <p class="small"><a class="link" href="/articles/">Writing</a></p>
      <h1 class="h1">{essay.title}</h1>
      <p class="small muted num">{formatDate(essay.date)}<span class="sep" aria-hidden="true"></span>{readMinutes(essay)} min read</p>
    </header>
    <div class="prose">
      {blocks(essay).map((b) =>
        b.kind === "h2" ? <h2>{b.text}</h2> : b.kind === "ul" ? <ul>{b.items.map((i) => <li>{i}</li>)}</ul> : <p>{b.text}</p>
      )}
    </div>
    <footer class="essay-foot">
      <p class="small muted">Next essay</p>
      <a class="h3" href={`/articles/${next.slug}/`}>{next.title}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .essay header { display: grid; gap: 22px; padding-top: clamp(40px, 7vw, 104px); max-width: 52rem; margin-bottom: clamp(48px, 6vw, 80px); }
  .sep { display: inline-block; width: 18px; }
  .essay-foot { display: grid; gap: 10px; margin-top: var(--section); padding-top: 28px; border-top: 1px solid var(--line); max-width: var(--measure); }
  .essay-foot a { transition: opacity 0.2s; }
  .essay-foot a:hover { opacity: 0.72; }
</style>
