---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";

const reasons = [
  "An AI workflow that has to become auditable, or has to fail closed when the evidence is missing.",
  "A research collaboration on evaluation, alignment or agent security.",
  "A talk or a piece of writing on trusting AI systems in production.",
];
---

<BaseLayout title="Contact | Ali Uyar" description="Write to Ali Uyar about auditable AI systems, research collaborations on evaluation, alignment and agent security, or talks.">
  <section class="wrap contact">
    <h1 class="h1">Contact</h1>
    <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <div class="grid">
      <p class="lede">
        I work full-time as AI lead at {SITE.employer} in Vienna. Next to that I take on a few conversations a year, where trusting an AI decision is the hard part.
      </p>
      <div>
        <h2 class="label">Good reasons to write</h2>
        <ul class="reasons">{reasons.map((r) => <li>{r}</li>)}</ul>
        <p class="small muted">Code and papers: <a class="link" href={SITE.github} rel="me">github.com/aliuyar1234</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: 32px; padding-top: clamp(40px, 7vw, 104px); }
  .mail {
    justify-self: start; color: var(--strong);
    font-size: clamp(1.75rem, 0.8rem + 4.2vw, 4.4rem); font-weight: 560; font-stretch: 112%; letter-spacing: -0.03em;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.16em; text-decoration-color: var(--line-strong);
    transition: text-decoration-color 0.25s var(--ease); overflow-wrap: anywhere;
  }
  .mail:hover { text-decoration-color: var(--strong); }
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px clamp(28px, 5vw, 72px); margin-top: clamp(32px, 5vw, 64px); }
  .label { font-size: 0.9375rem; font-weight: 560; margin-bottom: 14px; }
  .reasons { display: grid; gap: 0; margin-bottom: 28px; }
  .reasons li { padding-block: 16px; border-top: 1px solid var(--line); max-width: 58ch; }
  .reasons li:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 860px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
