---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Threads from "../components/bits/Threads";
import FigureSlot from "../components/FigureSlot.astro";
import PaperLinks from "../components/PaperLinks.astro";
import { SITE, formatDate } from "../lib/site";
import { figureFor, paperBySlug } from "../lib/papers";
import writing from "../content/writing.json";

const essays = ["quiet-question-of-personhood", "decision-architecture-in-complex-systems", "designing-for-reversibility-in-high-speed-systems"]
  .map((slug) => writing.find((w) => w.slug === slug)!)
  .filter(Boolean);

// Two papers on one fMRI corpus, asked in sequence (see each plate's TRUTH.md).
const flagship = [
  {
    paper: paperBySlug("language-neutral-or-language-specific"),
    question: "Which part of a sentence representation predicts the brain better?",
    answer: "The part the three languages share. Each sentence representation is split into a component the three languages have in common and a language-specific residual. In the middle-late layers the shared component predicts the brain's semantic regions better, in all six model-by-language tests and after correction for multiple comparisons.",
  },
  {
    paper: paperBySlug("inside-the-multilingual-transformer"),
    question: "Which computations inside the transformer carry that shared signal?",
    answer: "The attention side. Each of the 12 blocks is tapped at four points, and in every encoder and cohort the states around attention align with the semantic regions better than the feed-forward states, the opposite of what the pre-specified hypothesis predicted. Nine of the 12 best taps sit on the attention side.",
  },
];

// The questions the papers work on, each answered only as far as its papers go.
const questions = [
  {
    question: "Does an LLM judge follow the criterion it was given?",
    answer: "Accuracy alone cannot show it. A judge that follows its criterion changes its verdict when the criterion's meaning changes and keeps it when only the wording does; on a rubric task, both judges tested look accurate yet often miss the change in meaning. The same check applies to the answers being judged: formatting that keeps a question's meaning can still flip a model's answer.",
    slugs: ["criterion-fidelity-in-llm-judges", "ria"],
  },
  {
    question: "Does a right answer mean the reasoning was valid?",
    answer: "A right final answer does not show that each step was valid. On structured arithmetic and logic problems, hidden states predict the final outcome well, but a verifier trained on outcomes does not check the steps; trained on whether each step is valid, it does better on the strictest step-level tests, most clearly on logic. In Qwen2.5-7B, hidden states also signal whether the context was enough to answer, separately from whether the answer was right.",
    slugs: ["outcome-is-not-verification", "binary-evidence-sufficiency"],
  },
  {
    question: "When an agent games its metric, how do you train against the step where it goes wrong?",
    answer: "Find the first step where the agent crosses the line, rewrite only that step into a minimal safe alternative and train on the contrast, then measure the effect on held-out tasks where the metric can be gamed.",
    slugs: ["first-unsafe-step-dpo"],
  },
  {
    question: "What does an agent carry forward after an attack, and how is it removed?",
    answer: "A prompt injection written into memory keeps acting after the attack ends. Once the poisoned entries are known, selective replay removes everything that descended from them and replays only the writes they touched, so the attack stops while the agent keeps benign memory that a full reset would wipe.",
    slugs: ["selective-revocation-and-replay"],
  },
  {
    question: "How do you keep a self-improving model from locking in its own mistakes?",
    answer: "Each paper takes one part of the loop. Test-time updates stay temporary and only distillation may persist; the distillation step is stress-tested with poisoned demonstrations; deterministic verifiers decide whether each new version is promoted or rolled back.",
    slugs: ["discover-then-distill", "robust-discover-distill", "cis-technical-report"],
  },
  {
    question: "Can a trained model's behavior be changed, and the change checked?",
    answer: "A small patch on a frozen model can enforce a specification and come with an empirical certificate, bounded to a stated scope, that anyone can replay. An output format such as strict JSON can be split off as its own add-on to a shared adapter and still match an adapter trained for it directly. Function calling can be moved from a tuned model into an untuned one of the same size with added modules instead of full retraining.",
    slugs: ["certipatch", "soar", "same-size-capability-transfer"],
  },
  {
    question: "How much of an interpretability claim holds up against matched controls?",
    answer: "Several different circuits can reproduce the same behavior, so reproducing it is not yet an explanation, and a strict acceptance rule checked against matched controls changes the verdict in every setting it was run on. Some effects do hold: a sparse map of what instruction tuning changed recovers part of the tuned behavior, and how activations spread across layers still shifts with gain when event rates are held fixed.",
    slugs: ["scrubid", "what-survives-control-calibration", "surgical-post-training-diffing", "avalanchellm"],
  },
].map((q) => ({ ...q, papers: q.slugs.map(paperBySlug) }));

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": SITE.personId,
  name: SITE.name,
  url: `${SITE.url}/`,
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.jobTitle,
  worksFor: { "@type": "Organization", name: SITE.employer },
  address: { "@type": "PostalAddress", addressLocality: "Vienna", addressCountry: "AT" },
  knowsAbout: ["AI alignment", "AI security", "LLM evaluation", "Mechanistic interpretability", "AI agent safety", "LLM judges"],
  sameAs: [SITE.github],
};
---

<BaseLayout title={SITE.title} jsonLd={person}>
  <Hero><Threads slot="field" client:idle /></Hero>

  <section class="section wrap flagship" aria-labelledby="flagship">
    <header class="flag-head">
      <h2 class="h2" id="flagship">Reading multilingual transformers against the listening brain</h2>
      <p class="lede">
        94 people heard <i>Le Petit Prince</i> in English, French or Chinese while fMRI recorded them. Two papers read the same story
        through <span class="whitespace-nowrap">XLM-R-base</span> and the <span class="whitespace-nowrap">NLLB-200</span> encoder and use each sentence's representation to predict brain activity, region by region.
      </p>
    </header>
    <div class="flag-body">
      <ol class="flag-qs">
        {flagship.map(({ paper, question, answer }, i) => (
          <li class="flag-text">
            <p class="flag-q"><span class="pn num">{i + 1}</span><span>{question}</span></p>
            <p>{answer}</p>
            <h3 class="flag-title"><a href={`/research/${paper.slug}/`}>{paper.title}</a></h3>
            <PaperLinks paper={paper} />
          </li>
        ))}
      </ol>
      <div class="flag-figure"><FigureSlot slug={figureFor(flagship[0].paper)!} label={flagship[0].paper.title} /></div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="questions">
    <div class="section-head">
      <h2 class="h2" id="questions">Questions I work on</h2>
    </div>
    <ul class="questions">
      {questions.map((q) => (
        <li class="q">
          <h3 class="q-text">{q.question}</h3>
          <div class="q-body">
            <p>{q.answer}</p>
            <p class="q-papers small">
              {q.papers.map((p) => <a href={`/research/${p.slug}/`}>{p.short}</a>)}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <p class="all"><a class="link" href="/research/">All papers, by line of work</a></p>
  </section>

  <section class="section wrap" aria-labelledby="writing">
    <div class="section-head">
      <h2 class="h2" id="writing">Writing</h2>
      <a class="link" href="/articles/">All essays</a>
    </div>
    <ul class="essays">
      {essays.map((e) => (
        <li>
          <a href={`/articles/${e.slug}/`}>
            <h3 class="h3">{e.title}</h3>
            <p>{e.summary}</p>
            <p class="small muted">{formatDate(e.date)}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap closer" aria-label="Contact">
    <p class="lede">Questions about a paper, a collaboration or a talk: <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </section>
</BaseLayout>

<style>
  /* On the home page the plate shows as a card only; legend and caption live on the paper page. */
  .flag-figure :global(.iso-legend), .flag-figure :global(.iso-caption) { display: none; }

  .flagship { display: grid; gap: clamp(48px, 7vw, 96px); }
  .flag-head { display: grid; gap: 24px; max-width: 52rem; }
  .flag-head .lede { max-width: 52ch; }
  .flag-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .flag-qs { display: grid; gap: clamp(48px, 6vw, 72px); }
  .flag-text { display: grid; gap: 18px; max-width: 44ch; }
  .flag-figure { position: sticky; top: 48px; }
  .flag-q { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); color: var(--strong); font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem); font-weight: 560; font-stretch: 106%; letter-spacing: -0.012em; line-height: 1.25; }
  .flag-q .pn { font-size: 1rem; padding-top: 0.32em; }
  .flag-text > p:not(.flag-q), .flag-text > h3, .flag-text > :global(.paper-links) { margin-left: 2.4rem; }
  .flag-title { font-size: 0.9375rem; font-weight: 520; line-height: 1.4; color: var(--muted); }
  .flag-title a { transition: color 0.2s var(--ease); }
  .flag-title a:hover { color: var(--strong); }

  .questions { border-bottom: 1px solid var(--line); }
  .q {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px clamp(28px, 5vw, 72px);
    padding-block: 28px 32px;
    border-top: 1px solid var(--line);
  }
  .q-text { font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem); font-weight: 560; font-stretch: 104%; letter-spacing: -0.01em; line-height: 1.28; max-width: 28ch; }
  .q-body { display: grid; gap: 14px; max-width: 62ch; }
  .q-papers { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .q-papers a { color: var(--muted); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 0.22em; transition: color 0.2s var(--ease); }
  .q-papers a:hover { color: var(--strong); }
  .all { margin-top: 28px; }
  .pn { color: var(--muted); font-weight: 450; }

  .essays { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .essays a { display: grid; gap: 12px; padding-top: 22px; border-top: 1px solid var(--line); transition: border-color 0.25s var(--ease); }
  .essays a:hover { border-top-color: var(--strong); }

  @media (max-width: 960px) {
    .flag-body, .q { grid-template-columns: minmax(0, 1fr); }
    .flag-figure { position: static; order: -1; }
    .essays { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .flag-q { grid-template-columns: 1.6rem minmax(0, 1fr); }
    .flag-text > p:not(.flag-q), .flag-text > h3, .flag-text > :global(.paper-links) { margin-left: 1.6rem; }
  }
</style>
