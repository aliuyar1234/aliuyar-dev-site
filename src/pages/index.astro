---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTitle from "../components/HeroTitle";
import FigureSlot from "../components/FigureSlot.astro";
import PaperLinks from "../components/PaperLinks.astro";
import { SITE, formatDate } from "../lib/site";
import { THEMES, byTheme, featured, figureFor, paperBySlug, papers, themeOf } from "../lib/papers";
import writing from "../content/writing.json";

const essays = ["the-demo-is-not-the-product", "designing-for-reversibility-in-high-speed-systems", "decision-architecture-in-complex-systems"]
  .map((slug) => writing.find((w) => w.slug === slug)!)
  .filter(Boolean);

const order = ["criterion-fidelity-in-llm-judges", "selective-revocation-and-replay", "certipatch"];
const selected = order.map((slug) => featured.find((p) => p.slug === slug)!).filter(Boolean);

// The flagship: two papers on one fMRI corpus, asked in sequence. Numbers from the papers (see each plate's TRUTH.md).
const flagship = [
  {
    paper: paperBySlug("language-neutral-or-language-specific"),
    question: "Which part of a sentence representation does the brain track?",
    answer: "The part the three languages share. Each encoder state is split into a component built from the other two languages' translations and an orthogonal language-specific residual. Over the middle-late layers the shared component predicts the semantic regions better in all six model-by-language tests, by 0.019 to 0.061 in held-out Fisher z, and every test survives Holm correction.",
  },
  {
    paper: paperBySlug("inside-the-multilingual-transformer"),
    question: "Where inside the transformer is that shared signal computed?",
    answer: "On the attention side. Tapping 12 blocks at four states each, attention-side minus FFN-side Δz is positive for the semantic regions in all six encoder × cohort cells, where the pre-specified hypothesis predicted the FFN side. Of the 12 best taps, 9 are attention or post-attention states.",
  },
];

const propositions = [
  {
    n: "1", text: "Find the constraint.",
    subs: [
      ["1.1", "A model problem is often a data problem, a question problem or a trade-off nobody wants to make. The work happens at the layer where the outcome changes."],
      ["1.2", "Do not fix a data problem with a prompt, an ownership problem with a dashboard, or a judgment problem with more automation."],
    ],
  },
  {
    n: "2", text: "Keep the evidence close.",
    subs: [
      ["2.1", "When a system routes a case, blocks an action or changes a workflow, it leaves something to inspect afterwards."],
      ["2.2", "Evals answer product questions. A score that decides nothing is decoration."],
    ],
  },
  {
    n: "3", text: "Fail closed.",
    subs: [["3.1", "Decide what a system is trusted to do before it does it. Without the evidence, it does nothing."]],
  },
  {
    n: "4", text: "Fix the test before the result.",
    subs: [["4.1", "Acceptance rules are written down before the run, and whatever comes out gets reported."]],
  },
  {
    n: "5", text: "Cut the machinery.",
    subs: [["5.1", "Complexity has to earn its place. Sometimes the right move is a model, sometimes cleaner data, sometimes no AI at all."]],
  },
];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": SITE.personId,
  name: SITE.name,
  url: `${SITE.url}/`,
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.jobTitle,
  worksFor: { "@type": "Organization", name: SITE.employer },
  address: { "@type": "PostalAddress", addressLocality: "Vienna", addressCountry: "AT" },
  knowsAbout: ["AI alignment", "AI security", "LLM evaluation", "Mechanistic interpretability", "AI agent safety", "LLM judges"],
  sameAs: [SITE.github],
};
---

<BaseLayout title={SITE.title} jsonLd={person}>
  <section class="hero wrap">
    <div class="hero-copy">
      <HeroTitle client:media="(hover: hover) and (pointer: fine)" text="I make AI decisions auditable." />
      <p class="lede">
        AI lead in Vienna, building with AI for eight years. At {SITE.employer} I put agents to work on real decisions.
        My research builds the instruments that check them: {papers.length} papers on alignment, security, evaluation and interpretability.
      </p>
      <div class="actions">
        <a class="btn" href="/research/">Read the research</a>
        <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
    <div class="hero-figure">
      <FigureSlot slug="hero" label="A checkweigher for AI decisions" />
    </div>
  </section>

  <section class="section wrap flagship" aria-labelledby="flagship">
    <header class="flag-head">
      <p class="small muted">Flagship research</p>
      <h2 class="h1" id="flagship">Reading multilingual transformers against the listening brain</h2>
      <p class="lede">
        94 people heard Le Petit Prince in English, French or Chinese while fMRI recorded them. Two papers read the same story
        through <span class="whitespace-nowrap">XLM-R-base</span> and the <span class="whitespace-nowrap">NLLB-200</span> encoder and fit their sentence states to the brain, region by region.
      </p>
    </header>
    <div class="flag-body">
      <ol class="flag-qs">
        {flagship.map(({ paper, question, answer }, i) => (
          <li class="flag-text">
            <p class="flag-q"><span class="pn num">{i + 1}</span><span>{question}</span></p>
            <p>{answer}</p>
            <h3 class="flag-title"><a href={`/research/${paper.slug}/`}>{paper.title}</a></h3>
            <PaperLinks paper={paper} />
          </li>
        ))}
      </ol>
      <div class="flag-figure"><FigureSlot slug={figureFor(flagship[0].paper)!} label={flagship[0].paper.title} /></div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="selected">
    <div class="section-head">
      <h2 class="h2" id="selected">Selected research</h2>
      <a class="link" href="/research/">All {papers.length} papers</a>
    </div>
    <ul class="featured">
      {selected.map((p) => (
        <li class="feature">
          <p class="small muted">{themeOf(p.theme).name}</p>
          <h3 class="h3"><a href={`/research/${p.slug}/`}>{p.title}</a></h3>
          <p>{p.finding}</p>
          <PaperLinks paper={p} />
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="map">
    <div class="section-head">
      <h2 class="h2" id="map">The research program</h2>
      <p class="muted">{papers.length} papers, {THEMES.length} lines of work. Each links to its abstract, data sheet, PDF and code.</p>
    </div>
    <div class="map">
      {THEMES.map((t) => (
        <div class="map-col">
          <h3 class="map-head"><a href={`/research/#${t.key}`}>{t.name}</a><span class="muted num">{byTheme(t.key).length}</span></h3>
          <ul>
            {byTheme(t.key).map((p) => <li><a href={`/research/${p.slug}/`}>{p.short}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap work" aria-labelledby="work">
    <h2 class="h2" id="work">How I work</h2>
    <ol class="props">
      {propositions.map((p) => (
        <li>
          <p class="prop"><span class="pn num">{p.n}</span><span>{p.text}</span></p>
          <ol>
            {p.subs.map(([n, t]) => (
              <li class="sub"><span class="pn num">{n}</span><span>{t}</span></li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="writing">
    <div class="section-head">
      <h2 class="h2" id="writing">Writing</h2>
      <a class="link" href="/articles/">All essays</a>
    </div>
    <ul class="essays">
      {essays.map((e) => (
        <li>
          <a href={`/articles/${e.slug}/`}>
            <h3 class="h3">{e.title}</h3>
            <p>{e.summary}</p>
            <p class="small muted">{formatDate(e.date)}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap closer" aria-labelledby="closer">
    <h2 class="h1" id="closer">If an AI decision has to hold up afterwards, write to me.</h2>
    <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </section>
</BaseLayout>

<style>
  /* On the home page the plates show as cards only; legend and caption live on each paper page. */
  .hero :global(.iso-legend), .hero :global(.iso-caption),
  .flag-figure :global(.iso-legend), .flag-figure :global(.iso-caption) { display: none; }

  .flagship { display: grid; gap: clamp(48px, 7vw, 96px); }
  .flag-head { display: grid; gap: 24px; max-width: 52rem; }
  .flag-head .lede { max-width: 52ch; }
  .flag-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .flag-qs { display: grid; gap: clamp(48px, 6vw, 72px); }
  .flag-text { display: grid; gap: 18px; max-width: 44ch; }
  .flag-figure { position: sticky; top: 48px; }
  .flag-q { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); color: var(--strong); font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem); font-weight: 560; font-stretch: 106%; letter-spacing: -0.012em; line-height: 1.25; }
  .flag-q .pn { font-size: 1rem; padding-top: 0.32em; }
  .flag-text > p:not(.flag-q), .flag-text > h3, .flag-text > :global(.paper-links) { margin-left: 2.4rem; }
  .flag-title { font-size: 0.9375rem; font-weight: 520; line-height: 1.4; color: var(--muted); }
  .flag-title a { transition: color 0.2s var(--ease); }
  .flag-title a:hover { color: var(--strong); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-top: clamp(28px, 5vw, 72px);
  }
  .hero-copy { display: grid; gap: 28px; }
  .hero-copy :global(.hero-title) { font-size: clamp(2.7rem, 0.9rem + 4.4vw, 5.5rem); }
  .hero-copy .actions { margin-top: 8px; }

  .featured { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .feature { display: grid; gap: 14px; align-content: start; padding-top: 22px; border-top: 1px solid var(--line); }
  .feature h3 a { transition: opacity 0.2s; }
  .feature h3 a:hover { opacity: 0.75; }

  .map { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
  .map-col { display: grid; align-content: start; gap: 14px; padding: 22px clamp(12px, 1.6vw, 22px) 26px 0; }
  .map-col + .map-col { padding-left: clamp(12px, 1.6vw, 22px); border-left: 1px solid var(--line); }
  .map-head { display: flex; justify-content: space-between; gap: 12px; font-size: 0.9375rem; font-weight: 580; line-height: 1.3; min-height: 2.6em; }
  .map ul { display: grid; gap: 2px; }
  .map li a { display: block; padding-block: 5px; color: var(--text); font-size: 0.9375rem; line-height: 1.35; transition: color 0.2s var(--ease); }
  .map li a:hover { color: var(--strong); }

  .work { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 72px); }
  .props { display: grid; gap: 36px; counter-reset: none; }
  .prop, .sub { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 4px; }
  .prop { color: var(--strong); font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem); font-weight: 560; font-stretch: 106%; letter-spacing: -0.012em; line-height: 1.25; }
  .prop .pn { font-size: 1rem; padding-top: 0.32em; }
  .props ol { display: grid; gap: 10px; margin-top: 14px; }
  .sub { max-width: 60ch; }
  .pn { color: var(--muted); font-weight: 450; }

  .essays { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .essays a { display: grid; gap: 12px; padding-top: 22px; border-top: 1px solid var(--line); transition: border-color 0.25s var(--ease); }
  .essays a:hover { border-top-color: var(--strong); }

  .closer { display: grid; gap: 28px; }
  .closer h2 { max-width: 18ch; }
  .mail {
    justify-self: start;
    color: var(--strong);
    font-size: clamp(1.6rem, 0.9rem + 3.2vw, 3.6rem);
    font-weight: 560;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    text-decoration-color: var(--line-strong);
    transition: text-decoration-color 0.25s var(--ease);
  }
  .mail:hover { text-decoration-color: var(--strong); }

  @media (max-width: 1100px) {
    .map { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .map-col:nth-child(4) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 960px) {
    .hero, .work, .flag-body { grid-template-columns: minmax(0, 1fr); }
    .flag-figure { position: static; order: -1; }
    .featured, .essays { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .map { grid-template-columns: minmax(0, 1fr); }
    .map-col, .map-col + .map-col { padding-left: 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .map-head { min-height: 0; }
  }
</style>
