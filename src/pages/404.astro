    <p class="small muted num">404</p>
    <h1 class="h2">Page not found</h1>
    <p class="lede">There is nothing at this address. The papers are under Research, the essays under Writing.</p>
    <div class="actions">
      <a class="btn" href="/research/">Research</a>
      <a class="link" href="/articles/">Writing</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { display: grid; gap: 24px; justify-items: start; padding-top: clamp(40px, 7vw, 104px); }
</style>
