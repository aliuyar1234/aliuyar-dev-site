---
// Renders an anatomy figure from src/figures/<slug>/Figure.astro when it exists.
interface Props { slug: string; label?: string }
const { slug, label = slug } = Astro.props;
const figures = import.meta.glob<{ default: any }>("../figures/*/Figure.astro", { eager: true });
const Figure = figures[`../figures/${slug}/Figure.astro`]?.default;
---

{Figure ? <Figure /> : <div class="figure-pending" role="img" aria-label={label}><span class="mono">{label}</span></div>}

<style>
  .figure-pending {
    display: grid; place-items: center; aspect-ratio: 1 / 0.9;
    background: var(--surface); border: 1px solid var(--line); border-radius: 6px; color: var(--muted);
  }
</style>
