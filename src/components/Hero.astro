---
import { SITE } from "../lib/site";
---

<section class="hero">
  <div class="hero-field" aria-hidden="true"><slot name="field" /></div>
  <div class="wrap hero-copy">
    <h1>I'm Ali, a principal AI engineer in Vienna. I work on the evaluation, alignment, security and interpretability of AI systems.</h1>
    <p class="lede">
      Most of my research asks whether a claim about a model holds up under a harder test. The questions get more interesting
      as models get more capable.
    </p>
    <div class="actions">
      <a class="btn" href="/research/">Read the research</a>
      <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(72svh, 760px);
    padding-block: clamp(96px, 14vh, 160px) clamp(40px, 6vw, 80px);
  }
  /* The field runs up behind the header and fades out before the next section. */
  .hero-field {
    position: absolute;
    inset: -88px 0 0;
    z-index: -1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .hero-copy { display: grid; gap: 24px; }
  .hero-copy h1 {
    max-width: 34ch;
    font-size: clamp(1.5rem, 1.15rem + 1.3vw, 2.25rem);
    font-weight: 540;
    font-stretch: 104%;
    line-height: 1.22;
    letter-spacing: -0.018em;
  }
  .lede { max-width: 60ch; font-size: clamp(1.05rem, 1rem + 0.2vw, 1.15rem); }
  .actions { margin-top: 8px; }
</style>
