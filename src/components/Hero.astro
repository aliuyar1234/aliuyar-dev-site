---
import { SITE } from "../lib/site";
import { papers } from "../lib/papers";
---

<section class="hero">
  <div class="hero-field" aria-hidden="true"><slot name="field" /></div>
  <div class="wrap hero-copy">
    <h1 class="display">{SITE.name}</h1>
    <p class="role">{SITE.jobTitle} in Vienna. Research on alignment, security and evaluation.</p>
    <p class="lede">
      Eight years building AI systems, now agents that make real decisions at {SITE.employer}. The research tests what is
      claimed about such systems: whether a judge scores the criterion it was given, whether a poisoned agent memory can be
      recovered, whether an interpretability result holds against calibrated controls.
    </p>
    <div class="actions">
      <a class="btn" href="/research/">Read the {papers.length} papers</a>
      <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(84svh, 880px);
    padding-block: clamp(96px, 14vh, 180px) clamp(40px, 6vw, 88px);
  }
  /* The field runs up behind the header and fades out before the next section. */
  .hero-field {
    position: absolute;
    inset: -88px 0 0;
    z-index: -1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .hero-copy { display: grid; gap: 22px; }
  .hero-copy h1 { font-size: clamp(3.4rem, 1.2rem + 8.4vw, 9rem); line-height: 0.9; letter-spacing: -0.045em; }
  .role { color: var(--strong); font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem); font-weight: 540; font-stretch: 106%; letter-spacing: -0.01em; line-height: 1.3; max-width: 40ch; }
  .lede { max-width: 58ch; font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem); }
  .actions { margin-top: 10px; }
</style>
